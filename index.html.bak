<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmprendeNet</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#1DA1F2',
                    },
                },
            },
        };
    </script>
</head>
<body>
    <header class="bg-white dark:bg-gray-800 shadow-md transition-colors duration-500">
        <nav class="max-w-6x1 mx-auto flex items-center justify-between p-4">
            <div class="flex items-center gap-2">
                <img src="images/logo.jpg" alt="EmprendeNet Logo" class="h-20 w-30 rounded-3xl">
                <span class="text-2xl font-bold text-primario">EmprendeNet</span>
            </div>

            <ul class="hidden md:flex gap-6 text-sm font-medium">
                <li><a href="#inicio" class="hover:text-primario text-xl">Inicio</a></li>
                <li><a href="#Propuesta" class="hover:text-primario text-xl">Propuesta</a></li>
                <li><a href="#Acerca" class="hover:text-primario text-xl">Acerca</a></li>
                <li><a href="#Contacto" class="hover:text-primario text-xl">Contacto</a></li>
            </ul>

            <div class="flex items-center gap-3">
                <button id="modo" class="px-3 py-1 rounded bg-primario text-white text-sm hover:opacity-80 transition">
                    Cambiar tema
                </button>
            </div>
        </nav>
    </header>

    <!-- Hero del texto -->
        <section class="max-w-4xl mx-auto text-center py-12 px-6">
            <h1 class="text-4xl md:text-5xl font-extrabold">Bienvenido a EmprendeNet</h1>
            <p class="text-gray-500 mt-4">Descubre los nuevos emprendimientos locales</p>
        </section>
















































